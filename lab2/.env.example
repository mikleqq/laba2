# Copy to .env and adjust. docker compose picks these values up automatically.
LOG_LEVEL=INFO
JWT_SECRET=change-me-to-a-long-random-string
INTERNAL_TOKEN=dev-internal-token-change-me

# Where the single PostgreSQL database "shophub" runs (default: PostgreSQL installed on this machine)
DB_HOST=host.docker.internal
DB_PORT=5432

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345!
MAX_PAYMENT_AMOUNT=5000
