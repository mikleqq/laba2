# Configuration of order-service (environment variables; values below are for running it locally)
SERVICE_NAME=order-service
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://order_svc:order_pass@localhost:5432/order_db
PRODUCT_SERVICE_URL=http://localhost:8003
RABBITMQ_URL=amqp://shop:shop@localhost:5672/
JWT_SECRET=dev-secret-change-me
INTERNAL_TOKEN=dev-internal-token-change-me
HTTP_TIMEOUT_SECONDS=5
