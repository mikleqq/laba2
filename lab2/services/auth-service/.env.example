# Configuration of auth-service (environment variables; values below are for running it locally)
SERVICE_NAME=auth-service
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://auth_svc:auth_pass@localhost:5432/auth_db
USER_SERVICE_URL=http://localhost:8002
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345!
RABBITMQ_URL=amqp://shop:shop@localhost:5672/
JWT_SECRET=dev-secret-change-me
INTERNAL_TOKEN=dev-internal-token-change-me
HTTP_TIMEOUT_SECONDS=5
